{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Promptagotchi",
  "version": "0.2.0",
  "identifier": "io.github.aloeveraz.promptagotchi",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "../pets/pip/pet.json": "pets/pip/pet.json",
      "../pets/mochi/pet.json": "pets/mochi/pet.json",
      "../pets/volt/pet.json": "pets/volt/pet.json",
      "../hooks/promptagotchi-hook.sh": "hooks/promptagotchi-hook.sh",
      "../docs/making-pets.md": "docs/making-pets.md"
    },
    "category": "DeveloperTool",
    "copyright": "MIT License. Unofficial; not affiliated with Anthropic.",
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}